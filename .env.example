# 拷贝此文件为 `.env` 后按需修改
# Windows:  copy .env.example .env
# Linux:    cp .env.example .env

# ===== 数据库 =====
# M0 native 默认走本地 SQLite（无需任何外部服务）
DATABASE_URL=sqlite+aiosqlite:///./data/ontolohub.db
DATABASE_ECHO=false

# M1 切到 PostgreSQL（需先 docker compose up -d postgres）
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ontolohub

# ===== Redis 缓存（HIA-64 B1）=====
# M1 起引入：候选/映射/SHACL 报告/限流。
# REDIS_ENABLED=false 时降级为「无缓存」模式，业务继续走。
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_TITLE="OntoloHub API"
API_VERSION=0.1.0

# ===== 跨域（前端开发服务器地址） =====
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== 文件上传 =====
UPLOAD_MAX_SIZE_MB=50
UPLOAD_ALLOWED_TYPES=.csv,.xlsx,.json,.ttl,.owl,.nt

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FORMAT=text

# ===== 安全 =====
SECRET_KEY=change-me-in-production